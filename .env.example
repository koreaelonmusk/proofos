# Vertex AI / Gemini configuration.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# Gemini 3.5 Flash is served from the global endpoint.
# This is the Vertex AI location, NOT a Cloud Run region.
GOOGLE_CLOUD_LOCATION=global

# Health endpoint the runtime evidence collector probes.
# Point this at your Cloud Run service to collect real deployment evidence.
PROOFOS_HEALTH_URL=http://127.0.0.1:8081/healthz
PROOFOS_HEALTH_TIMEOUT=5
